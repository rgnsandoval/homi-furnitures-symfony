{% extends 'base.html.twig' %}

{% block title %}Homi Furniture{% endblock %}

{% block body %}
    <h1>Homi Furniture</h1>

    <h2>Shop by room</h2>
    <ul>
        {% for room in rooms %}
            <li><a href="{{ path('app_shop', {room: room.slug}) }}">{{ room.name }}</a></li>
        {% endfor %}
    </ul>

    <h2>Featured</h2>
    <ul>
        {% for product in featured %}
            <li><a href="{{ path('app_product', {slug: product.slug}) }}">{{ product.name }}</a> {{ product.effectivePrice|peso }}</li>
        {% else %}
            <li>Nothing featured yet.</li>
        {% endfor %}
    </ul>

    <h2>On sale</h2>
    <ul>
        {% for product in onSale %}
            <li><a href="{{ path('app_product', {slug: product.slug}) }}">{{ product.name }}</a> <s>{{ product.price|peso }}</s> {{ product.salePrice|peso }}</li>
        {% else %}
            <li>No sales right now.</li>
        {% endfor %}
    </ul>
{% endblock %}
