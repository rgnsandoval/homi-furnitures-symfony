{% extends 'base.html.twig' %}

{% block title %}{{ product.name }} - Homi Furniture{% endblock %}

{% block main %}
    <div class="page-container ui py-8 md:py-12">
        <nav class="mb-6 flex flex-wrap items-center gap-1.5 text-sm text-stone-500" aria-label="Breadcrumb">
            <a href="{{ path('app_shop') }}">Shop</a>
            <twig:Icon name="chevron" class="size-3" />
            <a href="{{ path('app_shop', {category: product.category.slug}) }}">{{ product.category.name }}</a>
        </nav>

        <div class="grid gap-8 lg:grid-cols-2 lg:gap-14">
            <div class="space-y-4">
                {% for image in product.images %}
                    <div class="aspect-[4/5] overflow-hidden rounded-3xl bg-army-100">
                        <img class="h-full w-full object-cover" src="{{ asset('uploads/products/' ~ image.filename) }}" alt="{{ image.altText ?? product.name }}" width="640" height="800" {{ loop.first ? '' : 'loading=lazy' }}>
                    </div>
                {% else %}
                    {% if product.image %}
                        <div class="aspect-[4/5] overflow-hidden rounded-3xl bg-army-100">
                            <img class="h-full w-full object-cover" src="{{ asset('uploads/products/' ~ product.image) }}" alt="{{ product.name }}" width="640" height="800">
                        </div>
                    {% endif %}
                {% endfor %}
            </div>

            <div class="lg:sticky lg:top-24 lg:h-fit">
                <p class="eyebrow">{{ product.brand ? product.brand.name : product.category.name }}</p>
                <h1 class="mt-3 !text-4xl">{{ product.name }}</h1>
                <p class="flex flex-wrap items-baseline gap-3">
                    <strong class="text-2xl font-bold tabular-nums text-army-950">{{ product.effectivePrice|peso }}</strong>
                    {% if product.onSale %}
                        <s class="tabular-nums text-stone-400">{{ product.price|peso }}</s>
                        <span class="status-pill is-cancelled">Save {{ shop_saving(product)|peso }}</span>
                    {% endif %}
                </p>
                <p class="mt-5 text-stone-600">{{ product.description }}</p>

                {% if variants is empty %}
                    <p class="mt-6 font-semibold text-army-950">Currently unavailable.</p>
                {% else %}
                    <form method="post" action="{{ path('app_cart_add') }}" id="add-to-cart" class="mt-7 space-y-4">
                        <input type="hidden" name="_token" value="{{ csrf_token('cart') }}">
                        {% if variants|length == 1 %}
                            <input type="hidden" name="variant" value="{{ variants|first.id }}">
                            <p class="font-semibold text-army-950">{{ variants|first.stock > 0 ? 'In stock' : 'Out of stock' }}</p>
                        {% else %}
                            <label class="field">Option
                                <select name="variant" id="variant-selector">
                                    {% for variant in variants %}
                                        <option value="{{ variant.id }}" {{ variant.stock <= 0 ? 'disabled' }}>
                                            {{ variant.name }} - {{ variant.unitPrice|peso }}{{ variant.stock <= 0 ? ' (out of stock)' }}
                                        </option>
                                    {% endfor %}
                                </select>
                            </label>
                        {% endif %}
                        <div class="flex items-end gap-3">
                            <label class="field w-24">Quantity <input type="number" name="quantity" value="1" min="1"></label>
                            <button type="submit" class="btn btn-primary min-h-[2.75rem] flex-1"><twig:Icon name="bag" class="size-4" /> Add to cart</button>
                        </div>
                    </form>
                {% endif %}

                {% if app.user %}
                    <form method="post" action="{{ path('app_wishlist_toggle', {id: product.id}) }}" class="mt-3">
                        <input type="hidden" name="_token" value="{{ csrf_token('wishlist') }}">
                        <button type="submit" class="btn btn-secondary w-full"><twig:Icon name="heart" class="size-4" :filled="inWishlist" /> {{ inWishlist ? 'Remove from wishlist' : 'Add to wishlist' }}</button>
                    </form>
                {% endif %}

                <h2>Details</h2>
                <dl>
                    <dt>Material</dt><dd>{{ product.material }}</dd>
                    {% if product.widthCm %}<dt>Dimensions (W x D x H)</dt><dd>{{ product.widthCm }} x {{ product.depthCm }} x {{ product.heightCm }} cm</dd>{% endif %}
                    {% if product.weightKg %}<dt>Weight</dt><dd>{{ product.weightKg }} kg</dd>{% endif %}
                    <dt>Assembly</dt><dd>{{ product.assemblyRequired ? 'Assembly required; our assembly service is available at checkout.' : 'Delivered assembled.' }}</dd>
                    {% if product.warrantyMonths %}<dt>Warranty</dt><dd>{{ product.warrantyMonths }} months</dd>{% endif %}
                    <dt>Lead time</dt><dd>{{ product.leadTimeDays }} days</dd>
                    {% for label, value in product.specifications ?? {} %}
                        <dt>{{ label|capitalize }}</dt><dd>{{ value|capitalize }}</dd>
                    {% endfor %}
                </dl>
            </div>
        </div>

        <section class="mt-16 max-w-3xl">
            <h2>Reviews{% if averageRating %} ({{ averageRating }} / 5){% endif %}</h2>
            <div class="space-y-4">
                {% for review in reviews %}
                    <article class="review card">
                        <strong class="text-army-950">{{ review.rating }} / 5</strong> by {{ review.author.fullName }}
                        <p class="mt-2">{{ review.body }}</p>
                        {% if review.photo %}<img class="mt-2 rounded-xl" src="{{ asset('uploads/reviews/' ~ review.photo) }}" alt="Photo from {{ review.author.fullName }}" width="200">{% endif %}
                    </article>
                {% else %}
                    <p>No reviews yet.</p>
                {% endfor %}
            </div>
            <twig:Pagination :total="reviews|length" :page="page" />

            {% if reviewForm %}
                <h3>Write a review</h3>
                {{ form_start(reviewForm) }}
                    {{ form_widget(reviewForm) }}
                    <button type="submit">Submit review</button>
                {{ form_end(reviewForm) }}
            {% endif %}
        </section>

        {% if related is not empty %}
            <section class="mt-16">
                <h2>Related products</h2>
                <div class="grid grid-cols-2 gap-x-3 gap-y-8 sm:gap-x-5 md:grid-cols-3 lg:grid-cols-4">
                    {% for item in related %}
                        <twig:ProductCard :product="item" />
                    {% endfor %}
                </div>
            </section>
        {% endif %}
    </div>
{% endblock %}
