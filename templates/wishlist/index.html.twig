{% extends 'base.html.twig' %}

{% block title %}Wishlist - Homi Furniture{% endblock %}

{% block body %}
    <h1>Wishlist</h1>

    {% if items|length == 0 %}
        <div class="rounded-3xl border border-dashed border-stone-300 px-6 py-16 text-center">
            <twig:Icon name="heart" class="mx-auto size-8 text-stone-400" />
            <p class="mt-4">Your wishlist is empty. <a href="{{ path('app_shop') }}">Browse the shop</a>.</p>
        </div>
    {% else %}
        <ul class="grid grid-cols-2 gap-x-3 gap-y-8 sm:gap-x-5 md:grid-cols-3 lg:grid-cols-4">
            {% for item in items %}
                {% set product = item.product %}
                <li class="wishlist-item">
                    <a href="{{ path('app_product', {slug: product.slug}) }}" class="block aspect-[4/5] overflow-hidden rounded-2xl bg-army-100">
                        <img class="h-full w-full object-cover" src="{{ asset('uploads/products/' ~ product.image) }}" alt="{{ product.name }}" loading="lazy" width="640" height="800">
                    </a>
                    <p class="mt-3 !mb-1"><a href="{{ path('app_product', {slug: product.slug}) }}">{{ product.name }}</a></p>
                    <div class="flex items-center justify-between gap-2">
                        <span class="font-bold tabular-nums text-army-950">{{ product.effectivePrice|peso }}</span>
                        <form method="post" action="{{ path('app_wishlist_toggle', {id: product.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('wishlist') }}">
                            <button type="submit" class="unstyled text-sm font-semibold text-clay hover:underline">Remove</button>
                        </form>
                    </div>
                </li>
            {% endfor %}
        </ul>
    {% endif %}

    <twig:Pagination :total="items|length" :page="page" />
{% endblock %}
