<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Homi Furniture{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        <nav aria-label="Main">
            <a href="{{ path('app_home') }}">Home</a>
            <a href="{{ path('app_shop') }}">Shop</a>
            <a href="{{ path('app_guide') }}">Fit guide</a>
            <a href="{{ path('app_contact') }}">Contact</a>
            {% if app.user %}
                <a href="{{ path('app_cart') }}">Cart</a>
                <a href="{{ path('app_wishlist') }}">Wishlist</a>
                <a href="{{ path('app_orders') }}">Orders</a>
                <a href="{{ path('app_account') }}">Account</a>
                <a href="{{ logout_path() }}">Log out</a>
            {% else %}
                <a href="{{ path('app_login') }}">Log in</a>
                <a href="{{ path('app_register') }}">Register</a>
            {% endif %}
        </nav>
        {% for type, messages in app.flashes(['success', 'error']) %}
            {% for message in messages %}
                <div class="flash flash-{{ type }}" role="alert">{{ message }}</div>
            {% endfor %}
        {% endfor %}
        {% block body %}{% endblock %}
    </body>
</html>
