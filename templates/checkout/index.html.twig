{% extends 'base.html.twig' %}

{% block title %}Checkout - Homi Furniture{% endblock %}

{% block body %}
    <h1>Checkout</h1>

    <ul>
        {% for item in items %}
            <li>{{ item.quantity }} x {{ item.variant.product.name }} - {{ item.variant.name }}</li>
        {% endfor %}
    </ul>

    {% if addresses is empty %}
        <p>You need a saved address first. <a href="{{ path('app_address_new') }}">Add an address</a>.</p>
    {% else %}
        <form method="post" action="{{ path('app_checkout_submit') }}" id="checkout-form" data-preview-url="{{ path('app_checkout_preview') }}" data-csrf="{{ csrf_token('checkout') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('checkout') }}">
            <input type="hidden" name="idempotencyKey" value="{{ idempotencyKey }}">

            <label>Deliver to
                <select name="address">
                    {% for address in addresses %}
                        <option value="{{ address.id }}">{{ address }}</option>
                    {% endfor %}
                </select>
            </label>
            <label>Shipping
                <select name="shippingMethod">
                    {% for method in shippingMethods %}
                        <option value="{{ method }}">{{ method|capitalize }}</option>
                    {% endfor %}
                </select>
            </label>
            <label>Payment
                <select name="paymentMethod">
                    {% for method in paymentMethods %}
                        <option value="{{ method }}">{{ {cod: 'Cash on delivery', gcash: 'GCash (simulated)', card: 'Card (simulated)', bank: 'Bank transfer'}[method] }}</option>
                    {% endfor %}
                </select>
            </label>
            <label>Voucher <input name="voucher" autocomplete="off"></label>
            <label><input type="checkbox" name="assembly" value="1"> Add assembly service</label>
            <label>Notes <textarea name="notes" maxlength="500"></textarea></label>

            <button type="button" id="preview-button">Preview totals</button>
            <dl id="preview" hidden>
                <dt>Subtotal</dt><dd data-field="subtotal"></dd>
                <dt>Shipping</dt><dd data-field="shippingFee"></dd>
                <dt>Assembly</dt><dd data-field="assemblyFee"></dd>
                <dt>Discount</dt><dd data-field="discount"></dd>
                <dt>Total</dt><dd data-field="total"></dd>
                <dt>Estimated delivery</dt><dd data-field="estimatedDeliveryDate"></dd>
            </dl>
            <ul id="preview-errors"></ul>

            <button type="submit">Place order</button>
        </form>

        <script>
            document.getElementById('preview-button').addEventListener('click', async () => {
                const form = document.getElementById('checkout-form');
                const data = new FormData(form);
                const response = await fetch(form.dataset.previewUrl, {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json', 'X-CSRF-Token': form.dataset.csrf},
                    body: JSON.stringify({
                        address: data.get('address'),
                        shippingMethod: data.get('shippingMethod'),
                        paymentMethod: data.get('paymentMethod'),
                        voucher: data.get('voucher'),
                        assembly: data.has('assembly'),
                    }),
                });
                const quote = await response.json();
                document.querySelectorAll('#preview [data-field]').forEach((node) => {
                    node.textContent = quote[node.dataset.field] ?? '';
                });
                document.getElementById('preview').hidden = false;
                document.getElementById('preview-errors').replaceChildren(...(quote.errors ?? []).map((message) => {
                    const item = document.createElement('li');
                    item.textContent = message;
                    return item;
                }));
            });
        </script>
    {% endif %}
{% endblock %}
