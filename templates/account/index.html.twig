{% extends 'base.html.twig' %}

{% block title %}Your account - Homi Furniture{% endblock %}

{% block body %}
    <h1>Your account</h1>
    <p>Signed in as {{ app.user.email }}{{ app.user.verified ? '' : ' (email not verified)' }}</p>
    <p><a href="{{ path('app_address_index') }}">Saved addresses</a></p>

    <h2>Profile</h2>
    {{ form_start(form) }}
        {{ form_widget(form) }}
        <button type="submit">Save profile</button>
    {{ form_end(form) }}
{% endblock %}
