{% extends 'base.html.twig' %}

{% block title %}Shop - Homi Furniture{% endblock %}

{% block main %}
    <div class="bg-army-50 pb-20 pt-12 md:pt-16">
        <div class="page-container">
            <p class="eyebrow">Designed to stay</p>
            <h1 class="font-display mt-3 text-4xl font-extrabold tracking-tight text-army-950 sm:text-5xl">
                {{ filters.q ? 'Results for “' ~ filters.q ~ '”' : 'Shop' }}
            </h1>

            <twig:RoomPills class="mt-8" :rooms="rooms" :active="filters.room" :showAll="true" />

            {% set query = app.request.query.all %}
            {% set activeFilters = 0 %}
            {% for key in ['q', 'brand', 'material', 'color', 'minPrice', 'maxPrice', 'maxWidth', 'maxDepth', 'maxHeight', 'inStock'] %}
                {% if query[key] is defined and query[key] is not same as('') %}{% set activeFilters = activeFilters + 1 %}{% endif %}
            {% endfor %}

            <div class="mt-8 grid gap-8 lg:grid-cols-[17rem_1fr]" data-controller="filters">
                <details class="ui group h-fit rounded-3xl border border-stone-200 bg-white p-5 lg:sticky lg:top-24" data-filters-target="panel" {{ activeFilters > 0 ? 'open' }}>
                    <summary class="font-display flex cursor-pointer list-none items-center justify-between font-bold text-army-950">
                        <span class="flex items-center gap-2">Filters{% if activeFilters > 0 %}<span class="grid size-6 place-items-center rounded-full bg-army-700 text-xs text-white">{{ activeFilters }}</span>{% endif %}</span>
                        <twig:Icon name="chevron" class="size-4 text-stone-400 transition group-open:rotate-90" />
                    </summary>
                    <form method="get" action="{{ path('app_shop') }}" class="mt-4 space-y-3">
                        <label class="field">Search <input id="site-search-panel" type="search" name="q" value="{{ filters.q }}" placeholder="Sofa, oak, rattan…"></label>
                        <label class="field">Room
                            <select name="room">
                                <option value="">Any</option>
                                {% for room in rooms %}
                                    <option value="{{ room.slug }}" {{ filters.room == room.slug ? 'selected' }}>{{ room.name }}</option>
                                {% endfor %}
                            </select>
                        </label>
                        <label class="field">Brand
                            <select name="brand">
                                <option value="">Any</option>
                                {% for brand in brands %}
                                    <option value="{{ brand.id }}" {{ filters.brand == brand.id ? 'selected' }}>{{ brand.name }}</option>
                                {% endfor %}
                            </select>
                        </label>
                        <label class="field">Material
                            <select name="material">
                                <option value="">Any</option>
                                {% for material in materials %}
                                    <option value="{{ material }}" {{ filters.material == material ? 'selected' }}>{{ material }}</option>
                                {% endfor %}
                            </select>
                        </label>
                        <label class="field">Color <input name="color" value="{{ filters.color }}"></label>
                        <div class="grid grid-cols-2 gap-3">
                            <label class="field">Min price <input name="minPrice" inputmode="decimal" value="{{ filters.minPrice }}"></label>
                            <label class="field">Max price <input name="maxPrice" inputmode="decimal" value="{{ filters.maxPrice }}"></label>
                        </div>
                        <div class="grid grid-cols-3 gap-2">
                            <label class="field text-xs">Max W (cm) <input name="maxWidth" inputmode="decimal" value="{{ filters.maxWidth }}"></label>
                            <label class="field text-xs">Max D (cm) <input name="maxDepth" inputmode="decimal" value="{{ filters.maxDepth }}"></label>
                            <label class="field text-xs">Max H (cm) <input name="maxHeight" inputmode="decimal" value="{{ filters.maxHeight }}"></label>
                        </div>
                        <label class="flex items-center gap-2 text-sm font-semibold"><input type="checkbox" name="inStock" value="1" {{ filters.inStock ? 'checked' }}> In stock</label>
                        <input type="hidden" name="sort" value="{{ sort }}">
                        <div class="flex items-center gap-3 pt-1">
                            <button type="submit" class="btn btn-primary flex-1">Apply</button>
                            <a href="{{ path('app_shop') }}" class="btn btn-secondary">Clear</a>
                        </div>
                    </form>
                </details>

                <div>
                    <div class="flex flex-wrap items-center justify-between gap-3">
                        <p class="text-sm text-stone-500">
                            <span class="font-semibold text-army-950">{{ products|length }}</span> {{ products|length == 1 ? 'product' : 'products' }}
                            {% if activeFilters > 0 %}· <a class="font-semibold text-army-700 hover:underline" href="{{ path('app_shop', filters.room ? {room: filters.room} : {}) }}">Clear filters</a>{% endif %}
                        </p>
                        <form method="get" action="{{ path('app_shop') }}" class="flex items-center gap-2">
                            {% for key, value in query %}
                                {% if key not in ['sort', 'page'] and value is not iterable %}<input type="hidden" name="{{ key }}" value="{{ value }}">{% endif %}
                            {% endfor %}
                            <label for="sort-by" class="text-sm text-stone-500">Sort by</label>
                            <select id="sort-by" name="sort" class="h-10 rounded-full border border-stone-200 bg-white pl-4 pr-9 text-sm font-semibold text-army-950 outline-none focus:border-army-500" data-action="filters#submit">
                                <option value="newest" {{ sort == 'newest' ? 'selected' }}>Newest</option>
                                <option value="price_asc" {{ sort == 'price_asc' ? 'selected' }}>Price: low to high</option>
                                <option value="price_desc" {{ sort == 'price_desc' ? 'selected' }}>Price: high to low</option>
                                <option value="name" {{ sort == 'name' ? 'selected' }}>Name</option>
                            </select>
                            <noscript><button type="submit" class="btn btn-secondary">Sort</button></noscript>
                        </form>
                    </div>
                    {% if products|length == 0 %}
                        <div class="mt-4 rounded-3xl border border-dashed border-stone-300 bg-white px-6 py-16 text-center">
                            <twig:Icon name="search" class="mx-auto size-8 text-stone-400" />
                            <h2 class="font-display mt-4 text-xl font-bold text-army-950">Nothing matches just yet</h2>
                            <p class="mt-2 text-sm text-stone-500">No products match these filters. Try another room, piece, or collection.</p>
                            <a class="mt-5 inline-block font-semibold text-army-700" href="{{ path('app_shop') }}">Clear filters</a>
                        </div>
                    {% else %}
                        <ul id="products" class="mt-4 grid grid-cols-2 gap-x-3 gap-y-8 sm:gap-x-5 md:grid-cols-3">
                            {% for product in products %}
                                <li><twig:ProductCard :product="product" /></li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                    <twig:Pagination :total="products|length" :page="page" />
                </div>
            </div>
        </div>
    </div>
{% endblock %}
