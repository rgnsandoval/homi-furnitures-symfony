{% props name, filled = false %}
<svg aria-hidden="true" {{ attributes.defaults({class: 'size-5'}) }} fill="{{ filled ? 'currentColor' : 'none' }}" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    {% if name == 'arrow' %}<path d="M5 12h14m-5-5 5 5-5 5"/>
    {% elseif name == 'bag' %}<path d="M6 8h12l1 12H5L6 8Z"/><path d="M9 9V6a3 3 0 0 1 6 0v3"/>
    {% elseif name == 'check' %}<path d="m5 12 4 4L19 6"/>
    {% elseif name == 'chevron' %}<path d="m9 18 6-6-6-6"/>
    {% elseif name == 'close' %}<path d="m6 6 12 12M18 6 6 18"/>
    {% elseif name == 'delivery' %}<path d="M3 6h11v10H3zM14 10h4l3 3v3h-7z"/><circle cx="7" cy="18" r="2"/><circle cx="18" cy="18" r="2"/>
    {% elseif name == 'heart' %}<path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.9-8.6a5.5 5.5 0 0 0-.1-7.8Z"/>
    {% elseif name == 'menu' %}<path d="M4 7h16M4 12h16M4 17h16"/>
    {% elseif name == 'search' %}<circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/>
    {% elseif name == 'shield' %}<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Zm-3-10 2 2 4-5"/>
    {% elseif name == 'spark' %}<path d="m12 3 1.3 4.7L18 9l-4.7 1.3L12 15l-1.3-4.7L6 9l4.7-1.3L12 3Z"/>
    {% elseif name == 'user' %}<circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/>
    {% endif %}
</svg>
