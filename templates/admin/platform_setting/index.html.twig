{% extends 'admin/layout.html.twig' %}

{% block title %}PlatformSetting index{% endblock %}

{% block body %}
    <h1>PlatformSetting index</h1>

    <div class="table-wrap">

        <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>SettingKey</th>
                <th>SettingValue</th>
                <th>Description</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for platform_setting in platform_settings %}
            <tr>
                <td>{{ platform_setting.id }}</td>
                <td>{{ platform_setting.settingKey }}</td>
                <td>{{ platform_setting.settingValue }}</td>
                <td>{{ platform_setting.description }}</td>
                <td>
                    <a href="{{ path('app_admin_platform_setting_show', {'id': platform_setting.id}) }}">show</a>
                    <a href="{{ path('app_admin_platform_setting_edit', {'id': platform_setting.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
        </table>
    </div>

    <twig:Pagination :total="platform_settings|length" :page="page" />

    <a href="{{ path('app_admin_platform_setting_new') }}">Create new</a>
{% endblock %}
