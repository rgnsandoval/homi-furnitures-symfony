{% extends 'admin/layout.html.twig' %}

{% block title %}Order {{ order.orderNumber }} - Admin{% endblock %}

{% block body %}
    {% set token = csrf_token('admin-order' ~ order.id) %}
    <h1>Order {{ order.orderNumber }}</h1>
    <p>Status: <strong id="order-status">{{ order.status }}</strong></p>
    <p>Customer: {{ order.customer.fullName }} ({{ order.customer.email }})</p>
    <p>Payment: {{ order.payment.method }} ({{ order.payment.status }}), {{ order.payment.amount|peso }}</p>
    {% if order.payment.proofFile %}<p><a href="{{ path('app_payment_proof', {id: order.payment.id}) }}">View payment proof</a></p>{% endif %}
    {% if order.cancelReason %}<p>Cancel reason: {{ order.cancelReason }}</p>{% endif %}
    {% if order.notes %}<p>Customer notes: {{ order.notes }}</p>{% endif %}
    <p><a href="{{ path('app_invoice', {id: order.id}) }}">Invoice</a></p>

    <h2>Items</h2>
    <ul>
        {% for item in order.items %}
            <li>{{ item.quantity }} x {{ item.productName }} - {{ item.variantName }} at {{ item.unitPrice|peso }}</li>
        {% endfor %}
    </ul>
    <p>Total: {{ order.total|peso }}{{ order.assemblyRequested ? ' (assembly requested)' }}</p>

    <h2>Move order</h2>
    {% for status in nextStatuses %}
        <form method="post" action="{{ path('app_admin_order_transition', {id: order.id}) }}">
            <input type="hidden" name="_token" value="{{ token }}">
            <input type="hidden" name="to" value="{{ status }}">
            <button type="submit">Mark {{ status }}</button>
        </form>
    {% else %}
        <p>No further moves.</p>
    {% endfor %}

    {% if canCancel %}
        <form method="post" action="{{ path('app_admin_order_cancel', {id: order.id}) }}">
            <input type="hidden" name="_token" value="{{ token }}">
            <label>Reason <input name="reason" maxlength="255" required></label>
            <button type="submit">Cancel order</button>
        </form>

        <section id="fraud" class="mt-6 rounded-2xl border border-amber-200 bg-amber-50 p-5">
            <h2 class="mt-0">Suspected fraud?</h2>
            <p class="text-sm text-stone-600">Cancels the order, puts the stock back and marks an unpaid payment as failed. You can also deactivate the customer so they cannot log in or order again.</p>
            <form method="post" action="{{ path('app_admin_order_fraud', {id: order.id}) }}" onsubmit="return confirm('Flag {{ order.orderNumber }} as fraud and cancel it?')">
                <input type="hidden" name="_token" value="{{ token }}">
                <label>What looked wrong (optional) <input name="note" maxlength="240" placeholder="e.g. fake bank proof, mismatched name"></label>
                {% if 'ROLE_ADMIN' not in order.customer.roles %}
                    <label class="flex items-center gap-2"><input type="checkbox" name="block" value="1" checked> Deactivate {{ order.customer.email }}</label>
                {% endif %}
                <button type="submit" class="mt-2" style="background: var(--color-clay)">Flag as fraud and cancel</button>
            </form>
        </section>
    {% endif %}

    <h2>Edit details</h2>
    <form method="post" action="{{ path('app_admin_order_details', {id: order.id}) }}">
        <input type="hidden" name="_token" value="{{ token }}">
        <label>Ship to
            <select name="address">
                {% for address in customerAddresses %}
                    <option value="{{ address.id }}" {{ order.shippingAddress and order.shippingAddress.id == address.id ? 'selected' }}>{{ address.label }}: {{ address.recipient }}, {{ address.line1 }}, {{ address.city }}</option>
                {% endfor %}
            </select>
        </label>
        <label>Estimated delivery <input type="date" name="estimatedDeliveryDate" value="{{ order.estimatedDeliveryDate ? order.estimatedDeliveryDate|date('Y-m-d') }}"></label>
        <label>Tracking number <input name="trackingNumber" maxlength="80" value="{{ order.trackingNumber }}"></label>
        <label>Customer notes <textarea name="notes" maxlength="500">{{ order.notes }}</textarea></label>
        <label>Internal note <textarea name="internalNote">{{ order.internalNote }}</textarea></label>
        <p class="text-xs text-stone-500">Items and prices are fixed once an order is placed, so totals always match what the customer was charged. To change items, cancel or delete this order and create a new one.</p>
        <button type="submit">Save details</button>
    </form>

    <h2>History</h2>
    <ol>
        {% for entry in history %}
            <li>{{ entry.createdAt|date('M j, Y g:i A') }}: {{ entry.fromStatus ?? 'new' }} to {{ entry.toStatus }}{% if entry.changedBy %} by {{ entry.changedBy.email }}{% endif %}{% if entry.note %} ({{ entry.note }}){% endif %}</li>
        {% endfor %}
    </ol>

    <section id="danger-zone" class="mt-10 rounded-2xl border border-red-200 p-5">
        <h2 class="mt-0 text-clay">Danger zone</h2>
        <p class="text-sm text-stone-600">Permanently deletes this order with its items, payment and history, whatever its status. Use it for fraud, test or duplicate orders. This cannot be undone; a summary is kept in the audit log.</p>
        {% if deleteEffects is not empty %}
            <ul class="mb-4 list-disc pl-5 text-sm text-stone-700">
                {% for effect in deleteEffects %}<li>{{ effect }}</li>{% endfor %}
            </ul>
        {% endif %}
        <form method="post" action="{{ path('app_admin_order_delete', {id: order.id}) }}">
            <input type="hidden" name="_token" value="{{ token }}">
            <label>Type <strong>{{ order.orderNumber }}</strong> to confirm <input name="confirm" autocomplete="off" required pattern="{{ order.orderNumber }}"></label>
            <button type="submit" class="mt-2" style="background: var(--color-clay)">Delete order permanently</button>
        </form>
    </section>
{% endblock %}
