{% extends 'admin/layout.html.twig' %}

{% block title %}Edit product - Admin{% endblock %}

{% block body %}
    <h1>Edit {{ product.name }}</h1>

    {{ include('admin/product/_form.html.twig', {'button_label': 'Update'}) }}

    <h2>Variants</h2>
    <ul>
        {% for variant in product.variants %}
            <li>
                {{ variant.name }} ({{ variant.sku }}): {{ variant.stock }} in stock
                <a href="{{ path('app_admin_product_variant_edit', {id: variant.id}) }}">edit</a>
                <a href="{{ path('app_admin_stock', {id: variant.id}) }}">adjust stock</a>
            </li>
        {% else %}
            <li>No variants yet, so this product cannot be sold.</li>
        {% endfor %}
    </ul>
    <p><a href="{{ path('app_admin_product_variant_new') }}">Add a variant</a></p>

    <h2>Gallery</h2>
    {% for image in product.images %}
        <figure>
            <img src="{{ asset('uploads/products/' ~ image.filename) }}" alt="{{ image.altText }}" width="120">
            <form method="post" action="{{ path('app_admin_product_image_delete', {id: image.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('delete-image' ~ image.id) }}">
                <button type="submit">Delete image</button>
            </form>
        </figure>
    {% else %}
        <p>No gallery images.</p>
    {% endfor %}

    <a href="{{ path('app_admin_product_index') }}">back to list</a>

    {{ include('admin/product/_delete_form.html.twig') }}
{% endblock %}
