{% extends 'admin/layout.html.twig' %}

{% block title %}{{ title }} - Admin{% endblock %}

{% block body %}
    <p class="mb-2"><a href="{{ user.id ? path('app_admin_user_show', {id: user.id}) : path('app_admin_user') }}">← Back</a></p>
    <h1>{{ title }}</h1>

    <div class="max-w-xl rounded-3xl border border-stone-200 bg-white p-6">
        {{ form_start(form) }}
            {{ form_widget(form) }}
            <button type="submit" class="mt-2">{{ user.id ? 'Save user' : 'Create user' }}</button>
        {{ form_end(form) }}
    </div>
{% endblock %}
