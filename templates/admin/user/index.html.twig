{% extends 'admin/layout.html.twig' %}

{% block title %}Users - Admin{% endblock %}

{% block body %}
    <div class="flex flex-wrap items-center justify-between gap-3">
        <h1 class="mb-0">Users</h1>
        <a class="btn btn-primary" href="{{ path('app_admin_user_new') }}">+ New user</a>
    </div>

    <form method="get" class="mt-6 flex flex-wrap items-end gap-3">
        <label class="min-w-0 flex-1">Search <input type="search" name="q" value="{{ q }}" placeholder="Name or email"></label>
        <button type="submit">Search</button>
    </form>

    <div class="table-wrap mt-4">
        <table>
        <thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Verified</th><th>Status</th><th></th></tr></thead>
        <tbody>
            {% for user in users %}
                <tr class="user">
                    <td><a href="{{ path('app_admin_user_show', {id: user.id}) }}">{{ user.fullName }}</a></td>
                    <td>{{ user.email }}</td>
                    <td>{{ 'ROLE_ADMIN' in user.roles ? 'Admin' : 'Customer' }}</td>
                    <td>{{ user.verified ? 'Yes' : 'No' }}</td>
                    <td><span class="status-pill {{ user.active ? '' : 'is-cancelled' }}">{{ user.active ? 'Active' : 'Deactivated' }}</span></td>
                    <td>
                        <div class="flex flex-wrap items-center gap-2">
                            <a href="{{ path('app_admin_user_edit', {id: user.id}) }}">Edit</a>
                            <form method="post" action="{{ path('app_admin_user_toggle', {id: user.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('user' ~ user.id) }}">
                                <button type="submit">{{ user.active ? 'Deactivate' : 'Activate' }}</button>
                            </form>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="6">No users found.</td></tr>
            {% endfor %}
        </tbody>
        </table>
    </div>

    <twig:Pagination :total="users|length" :page="page" />
{% endblock %}
