{% extends 'admin/layout.html.twig' %}

{% block title %}Users - Admin{% endblock %}

{% block body %}
    <h1>Users</h1>

    <form method="get">
        <label>Search <input type="search" name="q" value="{{ q }}"></label>
        <button type="submit">Search</button>
    </form>

    <div class="table-wrap">

        <table>
        <thead><tr><th>Name</th><th>Email</th><th>Roles</th><th>Verified</th><th>Status</th><th></th></tr></thead>
        <tbody>
            {% for user in users %}
                <tr class="user">
                    <td>{{ user.fullName }}</td>
                    <td>{{ user.email }}</td>
                    <td>{{ user.roles|join(', ') }}</td>
                    <td>{{ user.verified ? 'Yes' : 'No' }}</td>
                    <td>{{ user.active ? 'Active' : 'Deactivated' }}</td>
                    <td>
                        <form method="post" action="{{ path('app_admin_user_toggle', {id: user.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('user' ~ user.id) }}">
                            <button type="submit">{{ user.active ? 'Deactivate' : 'Activate' }}</button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="6">No users found.</td></tr>
            {% endfor %}
        </tbody>
        </table>
    </div>

    <twig:Pagination :total="users|length" :page="page" />
{% endblock %}
