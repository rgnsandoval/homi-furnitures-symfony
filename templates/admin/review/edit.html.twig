{% extends 'admin/layout.html.twig' %}

{% block title %}Edit review - Admin{% endblock %}

{% block body %}
    <p class="mb-2"><a href="{{ path('app_admin_review', {show: review.isApproved ? 'approved' : 'pending'}) }}">← Reviews</a></p>
    <h1>Edit review</h1>
    <p class="text-stone-600">{{ review.product.name }} · by {{ review.author.email }} on {{ review.createdAt|date('M j, Y') }}</p>

    <div class="max-w-xl rounded-3xl border border-stone-200 bg-white p-6">
        {{ form_start(form) }}
            {{ form_widget(form) }}
            <button type="submit" class="mt-2">Save review</button>
        {{ form_end(form) }}
    </div>
{% endblock %}
