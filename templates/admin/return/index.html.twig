{% extends 'admin/layout.html.twig' %}

{% block title %}Returns - Admin{% endblock %}

{% block body %}
    <h1>{{ show == 'all' ? 'All returns' : 'Open returns' }}</h1>

    <nav class="mb-6 flex flex-wrap gap-2" aria-label="Filter returns">
        <a class="pill-filter {{ show == 'open' ? 'is-active' }}" href="{{ path('app_admin_return') }}">Open</a>
        <a class="pill-filter {{ show == 'all' ? 'is-active' }}" href="{{ path('app_admin_return', {show: 'all'}) }}">All</a>
    </nav>

    <div class="space-y-4">
        {% for return in returns %}
            {% set token = csrf_token('return' ~ return.id) %}
            <article class="return rounded-2xl border border-stone-200 bg-white p-5">
                <div class="flex flex-wrap items-start justify-between gap-3">
                    <h2 class="m-0 text-lg"><a href="{{ path('app_admin_order_show', {id: return.parentOrder.id}) }}">{{ return.parentOrder.orderNumber }}</a>: {{ return.status }}</h2>
                    <a href="{{ path('app_admin_return_show', {id: return.id}) }}">Details</a>
                </div>
                <p class="mt-2 text-sm text-stone-500">From {{ return.customer.email }} on {{ return.createdAt|date('M j, Y') }}</p>
                <p>{{ return.returnReason }}</p>
                <p class="text-sm">Payment: {{ return.parentOrder.payment.method }} ({{ return.parentOrder.payment.status }}), {{ return.parentOrder.payment.amount|peso }}</p>
                {% if return.photo %}<p><a href="{{ path('app_return_photo', {id: return.id}) }}">View photo</a></p>{% endif %}

                {% if return.status == 'requested' %}
                    <form method="post" action="{{ path('app_admin_return_approve', {id: return.id}) }}">
                        <input type="hidden" name="_token" value="{{ token }}">
                        <label>Note <input name="adminNote"></label>
                        <button type="submit">Approve return</button>
                    </form>
                    <form method="post" action="{{ path('app_admin_return_reject', {id: return.id}) }}">
                        <input type="hidden" name="_token" value="{{ token }}">
                        <label>Note <input name="adminNote"></label>
                        <button type="submit">Reject return</button>
                    </form>
                {% elseif return.status == 'approved' %}
                    <form method="post" action="{{ path('app_admin_return_refund', {id: return.id}) }}">
                        <input type="hidden" name="_token" value="{{ token }}">
                        <label>Note <input name="adminNote"></label>
                        <button type="submit">Refund return</button>
                    </form>
                {% elseif return.adminNote %}
                    <p class="text-sm text-stone-500">Note: {{ return.adminNote }}</p>
                {% endif %}
            </article>
        {% else %}
            <p>{{ show == 'all' ? 'No returns yet.' : 'No open returns.' }}</p>
        {% endfor %}
    </div>

    <twig:Pagination :total="returns|length" :page="page" />
{% endblock %}
